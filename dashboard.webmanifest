{
  "name": "TheDashboard",
  "short_name": "TheDashboard",
  "description": "A personal daily dashboard for plans, habits, reminders and recall.",
  "id": "./#/dashboard",
  "start_url": "./#/dashboard",
  "scope": "./",
  "display": "standalone",
